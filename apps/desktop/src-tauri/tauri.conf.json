{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Nowhere Player",
  "version": "0.0.0",
  "identifier": "com.nowhere.player",
  "build": {
    "beforeDevCommand": "pnpm -C ../web dev",
    "beforeBuildCommand": "pnpm -C ../web build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
